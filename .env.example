# The server reads these from the environment (no dotenv needed):
#   export $(grep -v '^#' .env | xargs) && npm start      or      docker run --env-file .env ...
PORT=3000
# Required when NODE_ENV=production. At least 8 characters.
ADMIN_PASSWORD=change-me-please
NODE_ENV=production
# Set to 1 when the site is served over HTTPS (behind a reverse proxy) so the login cookie is marked Secure.
COOKIE_SECURE=1
# Optional: fixed key for session cookies. Without it a random key is created once and stored in the database.
# SESSION_SECRET=
# Set to 0 to start with an empty shop instead of demo orders (only matters for a brand-new database).
SEED=0
# Optional: where the SQLite file lives.
# DB_PATH=./data/heliowatt.db
